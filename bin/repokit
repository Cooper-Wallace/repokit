#!/usr/bin/env python3
"""
repokit: Automate GitHub repository DevOps, Git hygiene, and archetype standards.

Features:
- Enforce clean GitHub merge strategies (Squash & Merge only, PR_TITLE, PR_BODY, delete branch on merge)
- Enforce branch protection / Rulesets on default branch (no direct pushes, require PR, prevent force push & deletion)
- Install local Conventional Commits hook (.git/hooks/commit-msg) and pre-commit audit hook (.git/hooks/pre-commit)
- Scaffold GitHub PR template (.github/pull_request_template.md)
- Scaffold Semantic PR GitHub Actions workflow (.github/workflows/semantic-pr.yml)
- Scaffold industry-standard solution archetypes (Python, Java, TypeScript, Bash)
- Audit existing repositories against DevOps and structural archetype standards (offline --local or remote)
- Create new portfolio-ready repositories with all standards pre-configured
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# Colors for terminal output
GREEN = "\033[1;32m"
RED = "\033[1;31m"
YELLOW = "\033[1;33m"
BLUE = "\033[1;34m"
CYAN = "\033[1;36m"
BOLD = "\033[1m"
RESET = "\033[0m"

TEMPLATES_DIR = Path(__file__).resolve().parent.parent / "templates"
DEFAULT_GOVERNANCE_REPO = "Cooper-Wallace/repokit"

COMMIT_PATTERN = r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_.-]+\))?!?: .+$"

COMMIT_MSG_HOOK = r'''#!/usr/bin/env bash
# Git commit-msg hook enforcing Conventional Commits
# (https://www.conventionalcommits.org/)

set -e

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# Allow merge commits, squashes, and fixups
if echo "$COMMIT_MSG" | grep -Eq "^(Merge|fixup!|squash!)"; then
    exit 0
fi

# Conventional Commits regex: type(optional-scope)!: description
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_.-]+\))?!?: .+$"

if ! echo "$COMMIT_MSG" | grep -Eq "$PATTERN"; then
    echo -e "\033[1;31m[ERROR] Commit rejected: Message does not follow Conventional Commits.\033[0m"
    echo -e "\033[1;33mExpected:\033[0m <type>(<scope optional>): <description>"
    echo -e "\033[1;33mAllowed Types:\033[0m feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo -e "\033[1;33mExamples:\033[0m"
    echo "  feat(laser): add pointcloud downsampling"
    echo "  fix(launch): correct topic remapping in simulation"
    echo "  docs(readme): add setup and launch instructions"
    echo -e "\033[1;31mYour input:\033[0m \"$COMMIT_MSG\""
    exit 1
fi
'''

PRE_COMMIT_HOOK = r'''#!/usr/bin/env bash
# Git pre-commit hook enforcing repokit local standards

if command -v repokit >/dev/null 2>&1; then
    REPOKIT_CMD="repokit"
elif [ -x "{bin_path}" ]; then
    REPOKIT_CMD="{bin_path}"
elif [ -x "${{HOME}}/.local/bin/repokit" ]; then
    REPOKIT_CMD="${{HOME}}/.local/bin/repokit"
else
    REPOKIT_CMD="repokit"
fi

if ! "$REPOKIT_CMD" audit --local; then
    echo -e "\033[1;31m[ERROR] Pre-commit check failed: Repository structure does not meet standards.\033[0m"
    echo -e "\033[1;33mPlease run:\033[0m repokit configure"
    exit 1
fi
'''

