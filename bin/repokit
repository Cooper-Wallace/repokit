DEFAULT_README = """# {repo_name}

{description}

---

## Overview
<!-- Provide a high-level overview of this project. -->

## Architecture & Design
<!-- Explain architectural choices, key components, or system design. -->

## Getting Started

### Prerequisites
<!-- List prerequisites, tools, or dependencies. -->

### Installation & Run
```bash
# Clone the repository
git clone https://github.com/{repo_slug}.git
cd {repo_name}
```

## Development & Contribution Flow
This project adheres to professional DevOps standards:
- **Conventional Commits**: Commits and PR titles must follow [Conventional Commits](https://www.conventionalcommits.org/).
- **Short-lived Feature Branches**: All changes are made via `feat/*` or `fix/*` branches and submitted as Pull Requests.
- **Squash Merges**: Pull requests are verified via CI quality gates and manually squashed into atomic entries on `main` via the GitHub UI (auto-merge disabled).
"""


def log_info(msg: str):
    print(f"{BLUE}[INFO]{RESET} {msg}")


def log_success(msg: str):
    print(f"{GREEN}[SUCCESS]{RESET} {msg}")


def log_warn(msg: str):
    print(f"{YELLOW}[WARN]{RESET} {msg}")


def log_error(msg: str):
    print(f"{RED}[ERROR]{RESET} {msg}")


def run_cmd(cmd: list[str], cwd: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            cmd,
            cwd=cwd,
            capture_output=True,
            text=True,
            check=check,
        )
    except subprocess.CalledProcessError as e:
        return e


def get_git_repo_root(path: Path | None = None) -> Path | None:
    p = path or Path.cwd()
    res = run_cmd(["git", "-C", str(p), "rev-parse", "--show-toplevel"], check=False)
    if res.returncode == 0 and res.stdout.strip():
        return Path(res.stdout.strip())
    return None


def get_git_hooks_dir(repo_root: Path) -> Path:
    res = run_cmd(["git", "-C", str(repo_root), "rev-parse", "--git-path", "hooks"], check=False)
    if res.returncode == 0 and res.stdout.strip():
        p = Path(res.stdout.strip())
        if not p.is_absolute():
            p = repo_root / p
        return p
    return repo_root / ".git" / "hooks"


def get_repo_slug(repo_root: Path) -> str | None:
    res = run_cmd(["git", "-C", str(repo_root), "remote", "get-url", "origin"], check=False)
    if res.returncode != 0 or not res.stdout.strip():
        return None
    url = res.stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+)/([^/\.]+?)(?:\.git)?$", url)
    if m:
        return f"{m.group(1)}/{m.group(2)}"
    return None


def get_github_user() -> str | None:
    res = run_cmd(["gh", "api", "user", "--jq", ".login"], check=False)
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    return None


def get_available_templates() -> dict[str, str]:
    return {
        "python": "Modern Python application/package (src layout, pyproject.toml, pytest, ruff)",
        "java": "Java Maven service (layered architecture: controller/service/model, JUnit 5)",
        "typescript": "TypeScript + Vite application (modular components, Vitest, strict TS)",
        "bash": "Standalone CLI utility in Bash (bin script, install.sh, smoke tests)",
    }


def apply_archetype_template(
    template_name: str,
    target_dir: Path,
    variables: dict[str, str] | None = None,
) -> bool:
    src_dir = TEMPLATES_DIR / template_name
    if not src_dir.exists():
        log_warn(f"Template directory not found at {src_dir}. Using generic scaffolding.")
        return False

    vars_dict = {"governance_slug": DEFAULT_GOVERNANCE_REPO}
    if variables:
        vars_dict.update(variables)
    if "governance_slug" not in vars_dict:
        vars_dict["governance_slug"] = DEFAULT_GOVERNANCE_REPO

    log_info(f"Applying '{template_name}' archetype scaffolding...")
    for root, dirs, files in os.walk(src_dir):
        rel_root = Path(root).relative_to(src_dir)

        # Replace variables in destination directory path
        dest_rel_str = str(rel_root)
        for k, v in vars_dict.items():
            dest_rel_str = dest_rel_str.replace(f"{{{{{k}}}}}", v)

        dest_dir = target_dir if dest_rel_str == "." else target_dir / dest_rel_str
        dest_dir.mkdir(parents=True, exist_ok=True)

        for f in files:
            src_file = Path(root) / f
            dest_fname = f
            for k, v in vars_dict.items():
                dest_fname = dest_fname.replace(f"{{{{{k}}}}}", v)

            dest_file = dest_dir / dest_fname

            try:
                content = src_file.read_text(encoding="utf-8")
                for k, v in vars_dict.items():
                    content = content.replace(f"{{{{{k}}}}}", v)
                dest_file.write_text(content, encoding="utf-8")
            except UnicodeDecodeError:
                # Binary files if any
                dest_file.write_bytes(src_file.read_bytes())

            # Preserve execute permissions or grant them to scripts/binaries
            is_executable = (
                os.access(src_file, os.X_OK)
                or dest_file.name.endswith(".sh")
                or dest_dir.name == "bin"
                or (content.startswith("#!") if "content" in locals() and isinstance(content, str) else False)
            )
            if is_executable:
                dest_file.chmod(0o755)

    log_success(f"Scaffolded '{template_name}' archetype layout.")
    return True


def detect_archetype(repo_root: Path) -> str | None:
    if (repo_root / "pyproject.toml").exists() or (repo_root / "setup.py").exists():
        return "python"
    if (repo_root / "pom.xml").exists() or (repo_root / "build.gradle").exists():
        return "java"
    if (repo_root / "tsconfig.json").exists() or (repo_root / "package.json").exists():
        return "typescript"
    if (repo_root / "bin").exists() and (repo_root / "install.sh").exists():
        return "bash"
    return None


def audit_archetype_structure(repo_root: Path, template_name: str | None) -> list[tuple[str, bool]]:
    archetype = template_name or detect_archetype(repo_root)
    if not archetype:
        return []

    checks: list[tuple[str, bool]] = []
    if archetype == "python":
        checks = [
            ("Python: 'src/' layout directory", (repo_root / "src").is_dir()),
            ("Python: 'tests/' directory", (repo_root / "tests").is_dir()),
            ("Python: 'pyproject.toml' configuration", (repo_root / "pyproject.toml").exists()),
        ]
    elif archetype == "java":
        checks = [
            ("Java: 'src/main/java' source tree", (repo_root / "src/main/java").is_dir()),
            ("Java: 'src/test/java' test tree", (repo_root / "src/test/java").is_dir()),
            ("Java: 'pom.xml' or 'build.gradle'", (repo_root / "pom.xml").exists() or (repo_root / "build.gradle").exists()),
        ]
    elif archetype == "typescript":
        checks = [
            ("TypeScript: 'src/' directory", (repo_root / "src").is_dir()),
            ("TypeScript: 'package.json' manifest", (repo_root / "package.json").exists()),
            ("TypeScript: 'tsconfig.json' config", (repo_root / "tsconfig.json").exists()),
        ]
    elif archetype == "bash":
        checks = [
            ("Bash: 'bin/' directory", (repo_root / "bin").is_dir()),
            ("Bash: 'install.sh' script", (repo_root / "install.sh").exists() and os.access(repo_root / "install.sh", os.X_OK)),
        ]

    return checks


def apply_github_repo_settings(repo_slug: str) -> bool:
    log_info(f"Applying GitHub merge and branch cleanup settings to {repo_slug}...")
    payload = {
        "allow_squash_merge": True,
        "allow_merge_commit": False,
        "allow_rebase_merge": False,
        "delete_branch_on_merge": True,
        "allow_update_branch": True,
        "squash_merge_commit_title": "PR_TITLE",
        "squash_merge_commit_message": "PR_BODY",
        "allow_auto_merge": False,
    }
    p = subprocess.run(
        ["gh", "api", "--method", "PATCH", f"repos/{repo_slug}", "--input", "-"],
        input=json.dumps(payload),
        capture_output=True,
        text=True,
    )
    if p.returncode == 0:
        log_success("GitHub repository settings updated (Squash only, PR_TITLE, auto-delete branches).")
        return True
    else:
        log_warn(f"Failed to update some repository settings via GitHub API: {p.stderr.strip()}")
        return False


def apply_branch_ruleset(
    repo_slug: str,
    default_branch: str = "~DEFAULT_BRANCH",
    required_checks: list[str] | None = None,
) -> bool:
    log_info(f"Configuring default branch protection ruleset on {repo_slug}...")
    p = subprocess.run(
        ["gh", "api", f"repos/{repo_slug}/rulesets"],
        capture_output=True,
        text=True,
    )
    existing_id = None
    if p.returncode == 0:
        try:
            rulesets = json.loads(p.stdout)
            for r in rulesets:
                if r.get("name") == "default-branch-protection":
                    existing_id = r.get("id")
                    break
        except Exception:
            pass

    if required_checks is None:
        if repo_slug.endswith("/repokit") or repo_slug == "repokit":
            required_checks = ["Test & Coverage", "Validate Conventional Commit PR Title"]
        else:
            required_checks = ["ci / Test & Coverage", "validate-pr / Validate Conventional Commit PR Title"]

    payload = {
        "name": "default-branch-protection",
        "target": "branch",
        "enforcement": "active",
        "conditions": {
            "ref_name": {
                "include": [default_branch],
                "exclude": [],
            }
        },
        "rules": [
            {"type": "deletion"},
            {"type": "non_fast_forward"},
            {
                "type": "pull_request",
                "parameters": {
                    "required_approving_review_count": 0,
                    "dismiss_stale_reviews_on_push": False,
                    "require_code_owner_review": False,
                    "require_last_push_approval": False,
                    "required_review_thread_resolution": False,
                    "allowed_merge_methods": ["squash"],
                },
            },
            {
                "type": "required_status_checks",
                "parameters": {
                    "strict_required_status_checks_policy": True,
                    "do_not_enforce_on_create": False,
                    "required_status_checks": [
                        {"context": ctx} for ctx in required_checks
                    ],
                },
            },
        ],
    }

    if existing_id:
        log_info(f"Updating existing ruleset (ID: {existing_id})...")
        p_rule = subprocess.run(
            ["gh", "api", "--method", "PUT", f"repos/{repo_slug}/rulesets/{existing_id}", "--input", "-"],
            input=json.dumps(payload),
            capture_output=True,
            text=True,
        )
    else:
        log_info("Creating new default branch protection ruleset...")
        p_rule = subprocess.run(
            ["gh", "api", "--method", "POST", f"repos/{repo_slug}/rulesets", "--input", "-"],
            input=json.dumps(payload),
            capture_output=True,
            text=True,
        )

    if p_rule.returncode == 0:
        log_success("Branch protection ruleset active (blocks direct pushes/force pushes, allows solo PR merge).")
        return True
    else:
        log_warn(f"Note on ruleset: {p_rule.stderr.strip() or p_rule.stdout.strip()}")
        log_info("If using a private repo on GitHub Free, rulesets or classic branch protection may require public visibility.")
        return False


def install_commit_hook(repo_root: Path) -> bool:
    hooks_dir = get_git_hooks_dir(repo_root)
    hook_path = hooks_dir / "commit-msg"
    try:
        hook_path.parent.mkdir(parents=True, exist_ok=True)
        hook_path.write_text(COMMIT_MSG_HOOK)
        hook_path.chmod(0o755)
        display_path = hook_path.relative_to(repo_root) if hook_path.is_relative_to(repo_root) else hook_path
        log_success(f"Installed Conventional Commits hook: {display_path}")
        return True
    except Exception as e:
        log_error(f"Failed to install git hook: {e}")
        return False


def install_pre_commit_hook(repo_root: Path) -> bool:
    hooks_dir = get_git_hooks_dir(repo_root)
    hook_path = hooks_dir / "pre-commit"
    bin_path = str(Path(__file__).resolve())
    hook_content = PRE_COMMIT_HOOK.format(bin_path=bin_path)
    try:
        hook_path.parent.mkdir(parents=True, exist_ok=True)
        hook_path.write_text(hook_content)
        hook_path.chmod(0o755)
        display_path = hook_path.relative_to(repo_root) if hook_path.is_relative_to(repo_root) else hook_path
        log_success(f"Installed pre-commit audit hook: {display_path}")
        return True
    except Exception as e:
        log_error(f"Failed to install git pre-commit hook: {e}")
        return False


def install_hooks(repo_root: Path, all_hooks: bool = False) -> bool:
    c_ok = install_commit_hook(repo_root)
    if all_hooks:
        p_ok = install_pre_commit_hook(repo_root)
        return c_ok and p_ok
    return c_ok


def scaffold_templates(repo_root: Path, force: bool = False) -> None:
    pr_template_path = repo_root / ".github" / "pull_request_template.md"
    if not pr_template_path.exists() or force:
        pr_template_path.parent.mkdir(parents=True, exist_ok=True)
        pr_template_path.write_text(PR_TEMPLATE)
        log_success("Scaffolded .github/pull_request_template.md")
    else:
        log_info("PR template already exists (use --force to overwrite).")

    workflow_path = repo_root / ".github" / "workflows" / "semantic-pr.yml"
    if not workflow_path.exists() or force:
        workflow_path.parent.mkdir(parents=True, exist_ok=True)
        workflow_path.write_text(WORKFLOW_SEMANTIC_PR)
        log_success("Scaffolded .github/workflows/semantic-pr.yml")
    else:
        log_info("Semantic PR workflow already exists (use --force to overwrite).")


def audit_repository(
    repo_root: Path,
    archetype: str | None = None,
    local_only: bool = False,
    remote_only: bool = False,
) -> bool:
    print(f"\n{BOLD}Auditing Repository Standards:{RESET} {repo_root}\n")

    if local_only and remote_only:
        run_local = True
        run_remote = True
    elif local_only:
        run_local = True
        run_remote = False
    elif remote_only:
        run_local = False
        run_remote = True
    else:
        run_local = True
        run_remote = True

    slug = None
    if run_remote:
        slug = get_repo_slug(repo_root)
        if not slug:
            log_error("No GitHub remote origin found for this repository.")
            return False
        print(f"{CYAN}GitHub Repository:{RESET} {slug}\n")
    else:
        slug = get_repo_slug(repo_root)
        if slug:
            print(f"{CYAN}GitHub Repository:{RESET} {slug} (local audit only)\n")
        else:
            print(f"{CYAN}Local Repository:{RESET} {repo_root.name} (local audit only)\n")

    remote_items: list[tuple[str, bool]] = []
    if run_remote and slug:
        p = run_cmd(["gh", "api", f"repos/{slug}"], check=False)
        gh_data = json.loads(p.stdout) if p.returncode == 0 else {}

        squash_enabled = gh_data.get("allow_squash_merge") is True
        merge_commit_disabled = gh_data.get("allow_merge_commit") is False
        rebase_disabled = gh_data.get("allow_rebase_merge") is False
        delete_branch = gh_data.get("delete_branch_on_merge") is True
        title_is_pr = gh_data.get("squash_merge_commit_title") == "PR_TITLE"
        msg_is_pr = gh_data.get("squash_merge_commit_message") in ("PR_BODY", "BLANK")
        auto_merge_disabled = gh_data.get("allow_auto_merge") is False

        p_rules = run_cmd(["gh", "api", f"repos/{slug}/rulesets"], check=False)
        has_ruleset = False
        ruleset_has_status_checks = False
        if p_rules.returncode == 0:
            try:
                rulesets = json.loads(p_rules.stdout)
                for r in rulesets:
                    if r.get("name") == "default-branch-protection" and r.get("enforcement") == "active":
                        has_ruleset = True
                        rules = r.get("rules", [])
                        if not rules and "id" in r:
                            p_detail = run_cmd(["gh", "api", f"repos/{slug}/rulesets/{r['id']}"], check=False)
                            if p_detail.returncode == 0:
                                try:
                                    detail = json.loads(p_detail.stdout)
                                    rules = detail.get("rules", [])
                                except Exception:
                                    pass
                        for rule in rules:
                            if rule.get("type") == "required_status_checks":
                                params = rule.get("parameters")
                                if params is None or not isinstance(params, dict):
                                    ruleset_has_status_checks = True
                                else:
                                    checks = params.get("required_status_checks")
                                    ruleset_has_status_checks = True if checks is None else len(checks) > 0
                                break
                        break
            except Exception:
                pass

        remote_items = [
            ("Squash & Merge Enabled", squash_enabled),
            ("Merge Commits Disabled", merge_commit_disabled),
            ("Rebase Commits Disabled", rebase_disabled),
            ("Auto-Delete Head Branches on Merge", delete_branch),
            ("Squash Commit Title set to PR_TITLE", title_is_pr),
            ("Squash Commit Message set to PR_BODY", msg_is_pr),
            ("Auto-Merge Disabled (Human Gate)", auto_merge_disabled),
            ("Default Branch Protection Ruleset Active", has_ruleset),
            ("Branch Ruleset Enforces Required Status Checks", ruleset_has_status_checks),
        ]

    local_items: list[tuple[str, bool]] = []
    if run_local:
        hooks_dir = get_git_hooks_dir(repo_root)
        hook_path = hooks_dir / "commit-msg"
        has_hook = hook_path.exists() and os.access(hook_path, os.X_OK)

        pre_hook_path = hooks_dir / "pre-commit"
        has_pre_hook = pre_hook_path.exists() and os.access(pre_hook_path, os.X_OK)

        has_pr_template = (repo_root / ".github" / "pull_request_template.md").exists()

        is_governance_hub = (
            (repo_root / ".github" / "workflows" / "reusable-python.yml").exists()
            and (repo_root / "bin" / "repokit").exists()
        )
        if is_governance_hub:
            has_ci_workflow = (repo_root / ".github" / "workflows" / "test.yml").exists()
            ci_label = "Central Reusable Workflows Hub Hosted (.github/workflows/reusable-*.yml)"
        else:
            ci_workflow_path = repo_root / ".github" / "workflows" / "ci.yml"
            has_ci_workflow = False
            if ci_workflow_path.exists():
                try:
                    ci_content = ci_workflow_path.read_text(encoding="utf-8")
                    if (
                        DEFAULT_GOVERNANCE_REPO in ci_content
                        or "reusable-" in ci_content
                        or "Cooper-Wallace/repokit" in ci_content
                    ):
                        has_ci_workflow = True
                except Exception:
                    pass

            ci_label = (
                "CI Workflow calling central repokit workflows (.github/workflows/ci.yml)"
                if has_ci_workflow
                else "CI Workflow missing or not calling central repokit reusable workflows"
            )

        local_items = [
            ("Local Conventional Commit Hook Installed (.git/hooks/commit-msg)", has_hook),
            ("Local Pre-commit Hook Installed (.git/hooks/pre-commit)", has_pre_hook),
            ("Pull Request Template (.github/pull_request_template.md)", has_pr_template),
            (ci_label, has_ci_workflow),
        ]

    all_passed = True

    if remote_items:
        print(f"{BOLD}GitHub Remote Governance Standards:{RESET}")
        for label, passed in remote_items:
            if passed:
                print(f"  {GREEN}✔{RESET} {label}")
            else:
                print(f"  {RED}✘{RESET} {label}")
                all_passed = False

    if local_items:
        if remote_items:
            print()
        print(f"{BOLD}Local Repository Standards:{RESET}")
        for label, passed in local_items:
            if passed:
                print(f"  {GREEN}✔{RESET} {label}")
            else:
                print(f"  {RED}✘{RESET} {label}")
                all_passed = False

    # Structure checks (performed in local or default mode)
    if run_local:
        struct_checks = audit_archetype_structure(repo_root, archetype)
        detected = archetype or detect_archetype(repo_root)
        if struct_checks:
            print(f"\n{BOLD}Archetype Structure Standards ({detected}):{RESET}")
            for label, passed in struct_checks:
                if passed:
                    print(f"  {GREEN}✔{RESET} {label}")
                else:
                    print(f"  {RED}✘{RESET} {label}")
                    all_passed = False
        else:
            has_src_dir = (
                (repo_root / "src").is_dir()
                or (repo_root / "bin").is_dir()
                or (repo_root / "src/main/java").is_dir()
            )
            print(f"\n{BOLD}Repository Structure Standards:{RESET}")
            if has_src_dir:
                print(f"  {GREEN}✔{RESET} Source directory structure present ('src/' or 'bin/')")
            else:
                print(f"  {RED}✘{RESET} Source directory structure missing (expected 'src/' or 'bin/')")
                all_passed = False

    print()
    if all_passed:
        log_success("All repository standards are strictly satisfied!")
        return True
    else:
        log_warn("Some standards are missing. Run `repokit configure` to automatically apply them.")
        return False


def scaffold_archetype_ci(repo_root: Path, force: bool = False) -> bool:
    archetype = detect_archetype(repo_root)
    if not archetype:
        return False
    template_ci = TEMPLATES_DIR / archetype / ".github" / "workflows" / "ci.yml"
    target_ci = repo_root / ".github" / "workflows" / "ci.yml"
    if template_ci.exists() and (not target_ci.exists() or force):
        target_ci.parent.mkdir(parents=True, exist_ok=True)
        content = template_ci.read_text(encoding="utf-8")
        content = content.replace("{{governance_slug}}", DEFAULT_GOVERNANCE_REPO)
        target_ci.write_text(content, encoding="utf-8")
        log_success("Scaffolded CI workflow calling central repokit workflows (.github/workflows/ci.yml)")
        return True
    elif target_ci.exists() and not force:
        log_info("CI workflow already exists (use --force to overwrite).")
        return False
    return False


def configure_repository(target: str | None, force: bool = False):
    repo_root = get_git_repo_root(Path(target) if target else None)
    if not repo_root:
        log_error(f"Target '{target or '.'}' is not inside a git repository.")
        sys.exit(1)

    slug = get_repo_slug(repo_root)
    if not slug:
        log_error("Could not find GitHub remote origin URL for this repository.")
        sys.exit(1)

    print(f"{BOLD}Configuring Repository:{RESET} {slug} ({repo_root})\n")

    apply_github_repo_settings(slug)
    apply_branch_ruleset(slug)
    install_hooks(repo_root, all_hooks=True)
    scaffold_templates(repo_root, force=force)
    scaffold_archetype_ci(repo_root, force=force)

    print()
    log_success("Repository configuration complete!")


def create_repository(
    name: str,
    description: str = "",
    public: bool = False,
    template_type: str | None = None,
    target_dir: str | None = None,
):
    user = get_github_user()
    if not user:
        log_error("Not authenticated with GitHub CLI. Please run `gh auth login` first.")
        sys.exit(1)

    slug = f"{user}/{name}"
    visibility = "--public" if public else "--private"
    path = Path(target_dir).resolve() if target_dir else Path.cwd() / name

    if path.exists() and any(path.iterdir()):
        log_error(f"Target directory {path} already exists and is not empty.")
        sys.exit(1)

    path.mkdir(parents=True, exist_ok=True)

    log_info(f"Creating new GitHub repository {slug} ({'public' if public else 'private'})...")
    create_args = ["gh", "repo", "create", slug, visibility]
    if description:
        create_args.extend(["--description", description])

    res = run_cmd(create_args)
    if res.returncode != 0:
        log_error(f"Failed to create repo via gh: {res.stderr.strip()}")
        sys.exit(1)

    log_success(f"GitHub repository created: https://github.com/{slug}")

    log_info(f"Initialising local repository at {path}...")
    run_cmd(["git", "init", "-b", "main"], cwd=path)
    run_cmd(["git", "remote", "add", "origin", f"https://github.com/{slug}.git"], cwd=path)

    # Variables for templating
    pkg_name = re.sub(r"[^a-zA-Z0-9_]", "_", name).lower()
    if pkg_name and pkg_name[0].isdigit():
        pkg_name = f"pkg_{pkg_name}"

    variables = {
        "repo_name": name,
        "package_name": pkg_name,
        "description": description or f"A standardised {template_type or 'software'} project.",
        "author": "Cooper Wallace",
        "year": "2026",
        "repo_slug": slug,
        "governance_slug": DEFAULT_GOVERNANCE_REPO,
    }

    # Apply archetype template if specified
    if template_type:
        apply_archetype_template(template_type, path, variables)
    else:
        readme_content = DEFAULT_README.format(
            repo_name=name,
            description=description or "A modern software engineering project.",
            repo_slug=slug,
        )
        (path / "README.md").write_text(readme_content)
        (path / ".gitignore").write_text(DEFAULT_GITIGNORE)

    # Core DevOps scaffolds
    scaffold_templates(path, force=True)
    install_hooks(path, all_hooks=True)

    # Initial commit
    run_cmd(["git", "add", "."], cwd=path)
    run_cmd(["git", "commit", "-m", "chore: initial repository scaffolding"], cwd=path)

    # Push to origin main
    log_info("Pushing initial commit to main...")
    push_res = run_cmd(["git", "push", "-u", "origin", "main"], cwd=path)
    if push_res.returncode != 0:
        log_warn(f"Initial push: {push_res.stderr.strip()}")

    # Apply GitHub Settings & Rulesets
    apply_github_repo_settings(slug)
    apply_branch_ruleset(slug)

    print()
    log_success(f"New repository {slug} initialised and fully standardised!")
    print(f"\n{CYAN}Next Steps:{RESET}")
    print(f"  cd {path}")
    print("  git checkout -b feat/initial-setup\n")


def print_templates():
    templates = get_available_templates()
    print(f"\n{BOLD}Available Solution Archetypes:{RESET}\n")
    for name, desc in templates.items():
        print(f"  {CYAN}{name:<12}{RESET} {desc}")
    print(f"\n{BOLD}Usage Example:{RESET}")
    print("  repokit create my-api --type python --public -d 'My Python service'\n")


def main():
    parser = argparse.ArgumentParser(
        prog="repokit",
        description="Automate GitHub repository DevOps and Git hygiene standards.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # create
    create_parser = subparsers.add_parser("create", help="Create a new standardised GitHub repo")
    create_parser.add_argument("name", help="Repository name")
    create_parser.add_argument("-d", "--description", default="", help="Repository description")
    create_parser.add_argument(
        "-t",
        "--type",
        choices=["python", "java", "typescript", "bash"],
        default=None,
        help="Solution archetype template",
    )
    create_parser.add_argument(
        "--public", action="store_true", help="Create as public repository (default: private)"
    )
    create_parser.add_argument("--path", help="Local directory path (default: ./{name})")

    # configure
    config_parser = subparsers.add_parser("configure", help="Apply standards to an existing repository")
    config_parser.add_argument(
        "path", nargs="?", default=None, help="Path to repo directory (default: current directory)"
    )
    config_parser.add_argument(
        "-f", "--force", action="store_true", help="Overwrite existing templates"
    )

    # audit
    audit_parser = subparsers.add_parser("audit", help="Audit repository compliance against standards")
    audit_parser.add_argument(
        "path", nargs="?", default=None, help="Path to repo directory (default: current directory)"
    )
    audit_parser.add_argument(
        "-t",
        "--type",
        choices=["python", "java", "typescript", "bash"],
        default=None,
        help="Specific archetype to verify",
    )
    audit_parser.add_argument(
        "--local", action="store_true", help="Audit local repository structure only (offline)"
    )
    audit_parser.add_argument(
        "--remote", action="store_true", help="Audit remote GitHub settings only"
    )

    # templates
    subparsers.add_parser("templates", help="List available solution archetype templates")

    # hook
    hook_parser = subparsers.add_parser("hook", help="Git hooks management")
    hook_sub = hook_parser.add_subparsers(dest="hook_command", required=True)
    hook_install = hook_sub.add_parser("install", help="Install Conventional Commits and pre-commit hooks")
    hook_install.add_argument(
        "path", nargs="?", default=None, help="Path to repo directory (default: current directory)"
    )
    hook_install.add_argument(
        "--all", action="store_true", help="Install all git hooks (commit-msg and pre-commit)"
    )

    args = parser.parse_args()

    if args.command == "create":
        create_repository(
            name=args.name,
            description=args.description,
            public=args.public,
            template_type=args.type,
            target_dir=args.path,
        )
    elif args.command == "configure":
        configure_repository(args.path, force=args.force)
    elif args.command == "audit":
        repo_root = get_git_repo_root(Path(args.path) if args.path else None)
        if not repo_root:
            log_error("Not inside a git repository.")
            sys.exit(1)
        passed = audit_repository(
            repo_root,
            archetype=args.type,
            local_only=args.local,
            remote_only=args.remote,
        )
        if not passed:
            sys.exit(1)
    elif args.command == "templates":
        print_templates()
    elif args.command == "hook" and args.hook_command == "install":
        repo_root = get_git_repo_root(Path(args.path) if args.path else None)
        if not repo_root:
            log_error("Not inside a git repository.")
            sys.exit(1)
        if args.all:
            install_hooks(repo_root, all_hooks=True)
        else:
            install_commit_hook(repo_root)
            log_info("Tip: Run 'repokit hook install --all' to also install the pre-commit audit hook.")


if __name__ == "__main__":
    main()
